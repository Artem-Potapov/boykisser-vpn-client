    <string name="debug_logs_dump_to_logcat" translatable="false">Dump to logcat</string>
    <string name="debug_logs_dump_status_file" translatable="false">Dumped to: %1$s</string>
    <string name="debug_logs_dump_status_logcat" translatable="false">Logcat dump: %1$d chunks (tag %2$s)</string>
    <string name="debug_logs_dump_failed" translatable="false">Dump failed: %1$s</string>
    <string name="debug_logs_dump_toast_file" translatable="false">Dump written to tmp file</string>
    <string name="debug_logs_dump_toast_logcat" translatable="false">Dumped %1$d chunks to logcat</string>
</resources>
